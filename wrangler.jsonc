{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-cc",
  "main": "proxy/worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/jira-proxy/*"]
  },
  "observability": { "enabled": false }
}

{
  "name": "dev-home",
  "version": "1.15.17",
  "private": true,
  "description": "Developer Home Dashboard - JIRA & GitHub integration",
  "repository": "https://github.com/siddiqus/dev-home",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && esbuild proxy/node.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "preview": "yarn build && yarn start",
    "deploy:cf": "yarn build && wrangler deploy",
    "lint": "eslint src/ proxy/",
    "lint:fix": "eslint src/ proxy/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bump": "sh ./scripts/bump-version.sh",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@optiaxiom/react": "^1.9.23",
    "@tabler/icons-react": "^3.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "axios": "^1.14.0",
    "bootstrap": "^5.3.8",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.1",
    "remark-breaks": "^4.0.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.5.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.145.0"
  },
  "lint-staged": {
    "{src,proxy}/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
